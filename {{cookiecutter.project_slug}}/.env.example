# Application
APP_NAME={{cookiecutter.project_name}}
APP_VERSION={{cookiecutter.version}}
DEBUG=True
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated list)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Database (async URL - used by both application and Alembic)
DATABASE_URL=sqlite+aiosqlite:///./{{cookiecutter.project_slug}}.db

# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname

# For MySQL:
# DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/dbname

# Security
SECRET_KEY=change-this-to-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
